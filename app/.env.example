DATABASE_URL="file:./dev.db"

# LLM provider selection:
#   "anthropic"  - Anthropic API (requires ANTHROPIC_API_KEY)
#   "openai"     - OpenAI API (requires OPENAI_API_KEY)
#   "claude-cli" - Shell out to local `claude` CLI (uses your Claude Code
#                  login, no API key needed). Run `claude auth login` once.
#   "codex-cli"  - Shell out to local `codex` CLI (uses your OpenAI login,
#                  no API key needed). Install with
#                  `npm install -g @openai/codex` and run `codex login`.
LLM_PROVIDER="anthropic"

# Anthropic credentials (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY="your-anthropic-key-here"
ANTHROPIC_MODEL="claude-sonnet-4-20250514"

# OpenAI credentials (used when LLM_PROVIDER=openai)
OPENAI_API_KEY="your-openai-key-here"
OPENAI_MODEL="gpt-4o"

# Claude Code CLI provider (used when LLM_PROVIDER=claude-cli)
# Uses your existing `claude` CLI login — no API key required.
CLAUDE_CLI_BIN="claude"
CLAUDE_CLI_MODEL="sonnet"

# Codex CLI provider (used when LLM_PROVIDER=codex-cli)
# Uses your existing `codex` CLI login — no API key required.
CODEX_CLI_BIN="codex"
